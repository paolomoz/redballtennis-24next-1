   "section": "rules-band",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "HOW TO PLAY"
    },
    {
     "role": "body",
     "order": 1,
     "text": "Players decide who serves first"
    },
    {
     "role": "body",
     "order": 2,
     "text": "Serve underhand, cross-court, with two chances to put the ball in play"
    },
    {
     "role": "body",
     "order": 3,
     "text": "The ball must bounce once on the return; no volleys!"
    },
    {
     "role": "body",
     "order": 4,
     "text": "Switch sides after every odd game"
    },
    {
     "role": "heading",
     "order": 5,
     "text": "HOW TO SCORE"
    },
    {
     "role": "body",
     "order": 6,
     "text": "First to 4 points wins the game"
    },
    {
     "role": "body",
     "order": 7,
     "text": "First to 4 games wins the set"
    },
    {
     "role": "body",
     "order": 8,
     "text": "The first player/team to win 2 out of 3 sets wins the match"
    },
    {
     "role": "body",
     "order": 9,
     "text": "Or play a timed match and the team with the most games wins"
    }
   ],
