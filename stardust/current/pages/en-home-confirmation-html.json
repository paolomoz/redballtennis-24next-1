      "innerText": "Sign InOne USTA Account, All Access.Your USTA account works across all USTA platforms \u2014 USTA members are limited to one account each.If you\u2019re a parent, start by creating your own USTA account. You can add your child later. Once they turn 13, they can create their own account or you can invite them to do so.SIGN IN header div { display: none; } header h1 { margin-bottom: 0 !important; } .usta-account-info { padding: 0 4px; } .usta-account-info b { display: block; margin-bottom: 8px; } One USTA Account, All Access. Your USTA account works across all USTA platforms \u2014 USTA members are limited to one account each. Not sure if you already have a USTA account? Find it here. Phone number or Email address *Email address or phone number is requiredEnter a valid email address or phone number. Phone numbers must include the country code.Password *Show passwordPassword is requiredThe password is too weakForgot password?SIGN INDon't have an account? Sign up document.addEventListener(\"DOMContentLoaded\", function() { var signUpURL = \"/u/signup?state=\" + ustaAuth.state; var usernameEl = document.getElementById(\"username\"); var passwordEl = document.getElementById(\"password\"); var errorEl = document.getElementById(\"username-error\"); var loginTypeEl = document.getElementById(\"login-type\"); var submitBtn = document.querySelector(\"button[data-action-button-primary='true']\"); var isNativeErrorsRemoved = false; var isUsernameErrorRemoved = false; document.getElementById(\"sign-up-link\").href = signUpURL; if (usernameEl && submitBtn && passwordEl) { usernameEl.insertAdjacentElement(\"afterend\", errorEl); submitBtn.disabled = disableSubmitButton(); usernameEl.addEventListener(\"input\", function() { if (!isNativeErrorsRemoved) ustaAuth.removeNativeErrors(); if (!isUsernameErrorRemoved) { isUsernameErrorRemoved = true; ustaAuth.hideError(errorEl, usernameEl); } submitBtn.disabled = disableSubmitButton(); }); usernameEl.addEventListener(\"focusout\", function() { if (disableSubmitButton(true)) { submitBtn.disabled = true; isUsernameErrorRemoved = false; } usernameEl.value.startsWith(\"+1\") ? loginTypeEl.value = \"phone\" : loginTypeEl.value = \"email\"; }); passwordEl.addEventListener(\"input\", function() { if (!isNativeErrorsRemoved) ustaAuth.removeNativeErrors(); submitBtn.disabled = disableSubmitButton(); }); function disableSubmitButton(showError = false) { return !(ustaAuth.isUsernameValid(errorEl, usernameEl, usernameEl.value, showError) && passwordEl.value.length > 0); } } }); OrContinue with GoogleContinue with AppleContinue with Facebook",
